[Unit]
Description=OmniRoy SBC Controller
After=multi-user.target

[Service]
Type=simple
User=omniroy
Group=omniroy
WorkingDirectory=/opt/omniroy/sbc-app
ExecStart=/usr/bin/java -jar /opt/omniroy/sbc-app/omniroy-sbc-controller.jar
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target